{
  "name": "nexliga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NexLiga community league hosting platform with matchday tools",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "db:migrate": "node scripts/migrate-postgres-schema.mjs",
    "migrate:dry-run": "node scripts/migrate-sqlite-to-supabase.mjs",
    "migrate:apply": "node scripts/migrate-sqlite-to-supabase.mjs --apply",
    "format": "prettier --write \"*.{html,css,js,mjs,json,yaml,yml}\" \"products/**/*.{html,css,js,mjs,json,yaml,yml}\" \"db/**/*.{js,mjs,json,yaml,yml}\" \"scripts/**/*.{js,mjs,json,yaml,yml}\" \"storage/**/*.{js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"*.{html,css,js,mjs,json,yaml,yml}\" \"products/**/*.{html,css,js,mjs,json,yaml,yml}\" \"db/**/*.{js,mjs,json,yaml,yml}\" \"scripts/**/*.{js,mjs,json,yaml,yml}\" \"storage/**/*.{js,mjs,json,yaml,yml}\""
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "google-auth-library": "^10.1.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
